<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="MageSuite\BrandManagement\Api\BrandsRepositoryInterface" type="MageSuite\BrandManagement\Model\BrandsRepository" />
    <preference for="MageSuite\BrandManagement\Api\Data\BrandsInterface" type="MageSuite\BrandManagement\Model\Brands" />
    <preference for="MageSuite\BrandManagement\Api\Data\BrandImagesInterface" type="MageSuite\BrandManagement\Model\BrandImages" />
    <preference for="MageSuite\BrandManagement\Api\BrandAttributeRepositoryInterface" type="MageSuite\BrandManagement\Model\BrandAttributeRepository"/>

    <type name="Magento\Eav\Model\Entity\AttributeCache">
        <arguments>
            <argument name="unsupportedTypes" xsi:type="array">
                <item name="brands" xsi:type="string">brands</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\UrlInterface">
        <plugin name="canonical_url_fix" type="MageSuite\BrandManagement\Plugin\Framework\UrlInterface\CanonicalUrlFix" sortOrder="10" />
    </type>

    <type name="Magento\Sitemap\Model\ItemProvider\Composite">
        <arguments>
            <argument name="itemProviders" xsi:type="array">
                <item name="brandLinksProvider" xsi:type="object">MageSuite\BrandManagement\Model\ItemProvider\BrandLinks</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Store\Model\StoreSwitcher">
        <arguments>
            <argument name="storeSwitchers" xsi:type="array">
                <item name="brand_url_switcher" xsi:type="object">MageSuite\BrandManagement\Model\StoreSwitcher\BrandUrlSwitcher</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="brandSearchIndexHandler" type="Smile\ElasticsuiteCore\Indexer\GenericIndexerHandler">
        <arguments>
            <argument name="indexName" xsi:type="string">brand_index</argument>
            <argument name="typeName" xsi:type="string">brand_type</argument>
        </arguments>
    </virtualType>

    <type name="MageSuite\BrandManagement\Model\Brands\Indexer\Fulltext">
        <arguments>
            <argument name="indexerHandler" xsi:type="object">brandSearchIndexHandler</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="brands_brands_listing_data_source" xsi:type="string">MageSuite\BrandManagement\Model\ResourceModel\Brands\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\EntityManager\MetadataPool">
        <arguments>
            <argument name="metadata" xsi:type="array">
                <item name="MageSuite\BrandManagement\Api\Data\BrandsInterface" xsi:type="array">
                    <item name="entityTableName" xsi:type="string">brands_entity</item>
                    <item name="identifierField" xsi:type="string">entity_id</item>
                    <item name="eavEntityType" xsi:type="string">brands</item>
                </item>
            </argument>
        </arguments>
    </type>

    <type name="MageSuite\BrandManagement\Model\Brands\ValidatorRules\RequiredFieldsAreNotEmpty">
        <arguments>
            <argument name="requiredFields" xsi:type="array">
                <item name="brand_name" xsi:type="string">brand_name</item>
                <item name="brand_url_key" xsi:type="string">brand_url_key</item>
            </argument>
        </arguments>
    </type>

    <type name="MageSuite\BrandManagement\Model\Brands\ValidatorRules\UniqueFieldsAreUnique">
        <arguments>
            <argument name="uniqueFields" xsi:type="array">
                <item name="brand_url_key" xsi:type="string">brand_url_key</item>
            </argument>
        </arguments>
    </type>

    <type name="MageSuite\BrandManagement\Service\SyncMediaGallery">
        <arguments>
            <argument name="batchSize" xsi:type="number">100</argument>
            <argument name="fileExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
        </arguments>
    </type>
</config>
