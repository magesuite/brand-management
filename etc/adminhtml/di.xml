<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="MageSuite\BrandManagement\Ui\DataProvider\Product\Form\Modifier\Pool"
                 type="Magento\Ui\DataProvider\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="eav" xsi:type="array">
                    <item name="class" xsi:type="string">MageSuite\BrandManagement\Ui\DataProvider\Brand\Form\Modifier\Eav</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                </item>
                <item name="image" xsi:type="array">
                    <item name="class" xsi:type="string">MageSuite\BrandManagement\Ui\DataProvider\Brand\Form\Modifier\Image</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
                <item name="attribute_set_id" xsi:type="array">
                    <item name="class" xsi:type="string">MageSuite\BrandManagement\Ui\DataProvider\Brand\Form\Modifier\AttributeSetId</item>
                    <item name="sortOrder" xsi:type="number">1000</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <type name="MageSuite\BrandManagement\Ui\DataProvider\Brand\Form\BrandDataProvider">
        <arguments>
            <argument name="pool" xsi:type="object">MageSuite\BrandManagement\Ui\DataProvider\Product\Form\Modifier\Pool</argument>
        </arguments>
    </type>
</config>
