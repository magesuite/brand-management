<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">brands_edit_form.brands_edit_form_data_source</item>
            <item name="namespace" xsi:type="string">brands_edit_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <deps>
            <dep>brands_edit_form.brands_edit_form_data_source</dep>
        </deps>
        <buttons>
            <button name="back" class="MageSuite\BrandManagement\Block\Adminhtml\Brands\Edit\BackButton"/>
            <button name="delete" class="MageSuite\BrandManagement\Block\Adminhtml\Brands\Edit\DeleteButton"/>
            <button name="save" class="MageSuite\BrandManagement\Block\Adminhtml\Brands\Edit\SaveButton"/>
        </buttons>
    </settings>
    <dataSource name="brands_edit_form_data_source" component="Magento_Ui/js/form/provider">
        <settings>
            <submitUrl path="*/brand/save"/>
        </settings>
        <dataProvider class="MageSuite\BrandManagement\Ui\DataProvider\Brand\Form\BrandDataProvider" name="brands_edit_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="content_constructor">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="label" xsi:type="string" translate="true">Content Constructor</item>
                <item name="sortOrder" xsi:type="number">10</item>
            </item>
        </argument>
        <container name="content_constructor_container">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">100</item>
                </item>
            </argument>
            <htmlContent name="html_content">
                <argument name="block" xsi:type="object">MageSuite\ContentConstructorAdmin\Block\Adminhtml\ContentConstructor\Brand</argument>
            </htmlContent>
        </container>
        <field name="components">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">page</item>
                    <item name="dataScope" xsi:type="string">components</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
