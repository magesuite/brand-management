<?php

/**
 * @var \MageSuite\BrandManagement\Block\All $block
 * @var \Magento\Framework\Escaper $escaper
 */
$brands = $block->getAllBrands();
$brandsByFirstLetter = $block->getBrandsGroupedByFirstLetter();

?>

<?php foreach ($brands as $brand): ?>
    <?php if(!empty($brand->getBrandIconUrl()) and $brand->getIsFeatured()): ?>
        <a href="<?= $escaper->escapeUrl($brand->getBrandUrl()) ?>" target="_blank">
            <img src="<?= $escaper->escapeUrl($brand->getBrandIconUrl()) ?>" alt="<?= $escaper->escapeHtmlAttr($brand->getBrandName()) ?>" height="100">
        </a>
    <?php endif; ?>
<?php endforeach;?>

<?php  foreach($brandsByFirstLetter as $letter => $brands): ?>
    <h3><?= $escaper->escapeHtml(strtoupper((string)$letter)) ?></h3>

    <br>
    <?php foreach ($brands as $brand) :?>
        <a href="<?= $escaper->escapeUrl($brand->getBrandUrl()) ?>" target="_blank"><?= $escaper->escapeHtml($brand->getBrandName()) ?></a><br />
    <?php endforeach;?>
<?php endforeach; ?>
