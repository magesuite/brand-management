<?php
/**
 * @var \MageSuite\ThemeHelpers\Block\Category\View\Headline $block
 * @var \Magento\Framework\Escaper $escaper
 */

$openingTag = sprintf('<%s class="page-title__headline cs-page-title__headline" id="page-title-heading" aria-labelledby="page-title-heading">', $block->getHeadlineHtmlTag());
$closingTag = sprintf('</%s>', $block->getHeadlineHtmlTag());

$viewModel = $block->getData('viewModel');
?>
<?php if (!$viewModel->shouldHeadlineBeHidden()) : ?>
    <div class="page-title-wrapper cs-page-title cs-page-title--page-category <?= $escaper->escapeHtmlAttr($block->getAdditionalCssClasses()) ?>">
        <div class="page-title">
            <?= /* @noEscape */ $openingTag ?>
            <span class="base" data-ui-id="page-title-wrapper"><?= $escaper->escapeHtml($block->getHeadline()) ?> </span>
            <?= /* @noEscape */ $closingTag ?>
            <?php if ($block->getShowCollectionSize()) : ?>
                <span class="secondary page-title__span">(<?= (int)$block->getCollectionSize() ?>)</span>
            <?php endif; ?>
        </div>
    </div>
<?php endif; ?>
